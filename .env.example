# Copy to .env. Safe local defaults only; never commit real secrets.
AI_PROFILE=free
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Core API (ASP.NET Core reads double-underscore names as nested settings)
ConnectionStrings__Core=Host=localhost;Database=knowledge_hub;Username=core_app;Password=core_app_dev
# At least 32 bytes. Generate one: openssl rand -base64 48
Auth__SigningKey=change-me-to-a-long-random-value-at-least-32-bytes
# The account registered with this email becomes the first admin (FR-ADM-04)
ADMIN_EMAIL=admin@example.com
CORE_MIGRATOR_CONNECTION=Host=localhost;Database=knowledge_hub;Username=core_migrator;Password=core_migrator_dev
AI_DATABASE_URL=postgresql://ai_app:ai_app_dev@localhost:5432/knowledge_hub
AI_MIGRATOR_DATABASE_URL=postgresql://ai_migrator:ai_migrator_dev@localhost:5432/knowledge_hub
AI_SERVICE_URL=http://localhost:8000
OLLAMA_BASE_URL=http://localhost:11434
SMTP_HOST=localhost
SMTP_PORT=1025
OTLP_ENDPOINT=http://localhost:4317
# Only for AI_PROFILE=claude:
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
