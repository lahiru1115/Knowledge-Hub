# Copy to .env. Safe local defaults only; never commit real secrets.
AI_PROFILE=free
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres
# Core API (ASP.NET Core reads double-underscore names as nested settings)
ConnectionStrings__Core=Host=localhost;Database=knowledge_hub;Username=core_app;Password=core_app_dev
# At least 32 bytes. Generate one: openssl rand -base64 48
Auth__SigningKey=change-me-to-a-long-random-value-at-least-32-bytes
# The account registered with this email becomes the first admin (FR-ADM-04)
ADMIN_EMAIL=admin@example.com
CORE_MIGRATOR_CONNECTION=Host=localhost;Database=knowledge_hub;Username=core_migrator;Password=core_migrator_dev
AI_DATABASE_URL=postgresql://ai_app:ai_app_dev@localhost:5432/knowledge_hub
AI_MIGRATOR_DATABASE_URL=postgresql://ai_migrator:ai_migrator_dev@localhost:5432/knowledge_hub
AI_SERVICE_URL=http://localhost:8000
# Shared by the Core API (signs) and the AI service (checks); at least 32 random bytes
SERVICE_JWT_SECRET=change-me-to-a-long-random-value-at-least-32-bytes
# Core API -> AI service. Off by default: the app runs without it and indexing jobs complete without calling it.
AiService__Enabled=false
# Under `docker compose up` the AI service is on by default; set AI_ENABLED=false here to turn it off there.
AiService__BaseUrl=http://localhost:8000
AiService__JwtSecret=change-me-to-a-long-random-value-at-least-32-bytes
OLLAMA_BASE_URL=http://localhost:11434
# Email (Mailpit in development: web UI on http://localhost:8025)
Smtp__Host=localhost
Smtp__Port=1025
Smtp__From=Knowledge Hub <no-reply@knowledge-hub.local>
# Public address of the web app, used in password reset links
Auth__AppBaseUrl=http://localhost:5173
OTLP_ENDPOINT=http://localhost:4317
# Only for AI_PROFILE=claude. Both keys are required, and so is a price for every model in use: the service
# refuses to start otherwise. Prices are US dollars per million tokens; take them from the providers' price pages.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# PRICE_TABLE={"claude-haiku-5-5": {"input": 0, "output": 0}, "claude-sonnet-5-5": {"input": 0, "output": 0}, "voyage-4-lite": {"input": 0}}
# Models (defaults shown for the Claude profile): SUMMARY_MODEL is used for summaries and tag suggestions.
# SUMMARY_MODEL=claude-haiku-5-5
# LLM_MODEL=claude-sonnet-5-5
# EMBEDDING_MODEL=voyage-4-lite
# Cost caps: per user per day, and for the whole deployment per month. At the monthly cap, summaries, tag
# suggestions and chat fall back to the free providers.
# DAILY_COST_CAP_USD=0.50
# MONTHLY_COST_CAP_USD=10
