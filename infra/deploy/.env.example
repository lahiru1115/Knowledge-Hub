# Copy to .env on the VM (never commit it). Generate each secret with: openssl rand -base64 48
REGISTRY=ghcr.io/OWNER            # where deploy.yml pushes the images (lower case)
TAG=latest
API_HOST=api.example.com          # public host name of the VM; its DNS A/AAAA record must point here before first start
APP_BASE_URL=https://app.example.com   # the web app's public address, used in password reset links
ADMIN_EMAIL=you@example.com       # the account registered with this address becomes the administrator

# Neon: one database, four roles created once with infra/db/init.sql (with passwords changed). Use the POOLED host for
# the apps and the DIRECT host for the migrators.
CORE_APP_CONNECTION=Host=ep-xxx-pooler.region.aws.neon.tech;Database=knowledge_hub;Username=core_app;Password=CHANGE;SSL Mode=Require
CORE_MIGRATOR_CONNECTION=Host=ep-xxx.region.aws.neon.tech;Database=knowledge_hub;Username=core_migrator;Password=CHANGE;SSL Mode=Require
AI_APP_DATABASE_URL=postgresql://ai_app:CHANGE@ep-xxx-pooler.region.aws.neon.tech/knowledge_hub?sslmode=require
AI_MIGRATOR_DATABASE_URL=postgresql://ai_migrator:CHANGE@ep-xxx.region.aws.neon.tech/knowledge_hub?sslmode=require

AUTH_SIGNING_KEY=
SERVICE_JWT_SECRET=

# Email provider with SMTP (OI-04). Password reset does not work without one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Knowledge Hub <no-reply@example.com>

# AI. "free" runs Ollama on the VM (start with --profile free-ai); "claude" needs the keys and PRICE_TABLE (see the root
# .env.example) and does not need Ollama.
AI_ENABLED=true
AI_PROFILE=free
LLM_MODEL=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
PRICE_TABLE=
DAILY_COST_CAP_USD=0.50
MONTHLY_COST_CAP_USD=10

# Traces and metrics go nowhere unless an OTLP endpoint is set. Logs always go to stdout as JSON.
TRACE_SAMPLE_RATIO=0.2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
