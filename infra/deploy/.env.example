# Copy to .env on the VM (never commit it). Generate each secret with: openssl rand -base64 48
REGISTRY=ghcr.io/OWNER            # where deploy.yml pushes the images (lower case)
TAG=latest
SITE_HOST=demo.example.com        # the one public host name: the web app and /api. Its DNS record must point at the VM first
APP_BASE_URL=https://demo.example.com  # the same address with https://, used in password reset links
ADMIN_EMAIL=you@example.com       # the account registered with this address becomes the administrator

# Database. The default is PostgreSQL on this VM (ADR-012): run ./make-init.sh once and paste the lines it prints here
# (it sets COMPOSE_PROFILES, the passwords and the four connection settings below). To use Neon instead, remove
# `local-db` from COMPOSE_PROFILES and fill these in with Neon's hosts: the POOLED host for the apps, the DIRECT host for
# the migrators. Neon Free switches compute off after ~100 hours a month and our background worker keeps it awake.
#   CORE_APP_CONNECTION=Host=ep-xxx-pooler.region.aws.neon.tech;Database=knowledge_hub;Username=core_app;Password=...;SSL Mode=Require
#   CORE_MIGRATOR_CONNECTION=Host=ep-xxx.region.aws.neon.tech;Database=knowledge_hub;Username=core_migrator;Password=...;SSL Mode=Require
#   AI_APP_DATABASE_URL=postgresql://ai_app:...@ep-xxx-pooler.region.aws.neon.tech/knowledge_hub?sslmode=require
#   AI_MIGRATOR_DATABASE_URL=postgresql://ai_migrator:...@ep-xxx.region.aws.neon.tech/knowledge_hub?sslmode=require
COMPOSE_PROFILES=local-db,free-ai   # add free-ai for Ollama; leave it out with AI_PROFILE=claude
POSTGRES_SUPERUSER_PASSWORD=
CORE_APP_CONNECTION=
CORE_MIGRATOR_CONNECTION=
AI_APP_DATABASE_URL=
AI_MIGRATOR_DATABASE_URL=

AUTH_SIGNING_KEY=
SERVICE_JWT_SECRET=

# Email: Brevo's SMTP relay (ADR-012). In Brevo: verify the sending domain (SPF and DKIM), then create an SMTP key.
# SMTP_FROM must be an address on the verified domain. Password reset does not work without this.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=          # the login Brevo shows under SMTP & API
SMTP_PASSWORD=          # the SMTP key
SMTP_FROM=Knowledge Hub <no-reply@demo.example.com>

# AI. "free" runs Ollama on the VM (profile free-ai); "claude" needs the keys and PRICE_TABLE (see the root
# .env.example) and does not need Ollama.
AI_ENABLED=true
AI_PROFILE=free
LLM_MODEL=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
PRICE_TABLE=
DAILY_COST_CAP_USD=0.50
MONTHLY_COST_CAP_USD=10

# Traces and metrics go nowhere unless an OTLP endpoint is set. Logs always go to stdout as JSON.
TRACE_SAMPLE_RATIO=0.2
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
